<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

        <entity name="App\Entity\LocalNames" table="local_names">

                <id name="id" type="integer" column="id">
                        <generator strategy="AUTO"/>
                </id>

                <field name="language" column="language" type="string" length="100" nullable="true"/>
                <field name="localName" column="localName" type="string" length="100" nullable="true"/>

                <many-to-one field="tree" target-entity="App\Entity\Tree" inversed-by="localNames">
                        <join-column name="treeId" referenced-column-name="id" nullable="true"/>
                </many-to-one>

        </entity>

</doctrine-mapping>