<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="App\Entity\Favorite" table="favorites">
        <id name="id" type="integer" column="id"><generator strategy="AUTO"/></id>
        <many-to-one field="user" target-entity="App\Entity\User">
            <join-column name="user_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
        <many-to-many field="trees" target-entity="App\Entity\Tree">
            <join-table name="favorites_tree">
                <join-columns><join-column name="favorites_id" referenced-column-name="id" on-delete="CASCADE"/></join-columns>
                <inverse-join-columns><join-column name="tree_id" referenced-column-name="id" on-delete="CASCADE"/></inverse-join-columns>
            </join-table>
        </many-to-many>
    </entity>
</doctrine-mapping>