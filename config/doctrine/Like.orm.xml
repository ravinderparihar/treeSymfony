<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="App\Entity\Like" table="likes">
        <id name="id" type="integer" column="id"><generator strategy="AUTO"/></id>
        <field name="type" type="integer" column="type"/>
        <many-to-one field="tree" target-entity="App\Entity\Tree">
            <join-column name="treeId" referenced-column-name="id" nullable="false"/>
        </many-to-one>
        <many-to-one field="user" target-entity="App\Entity\User">
            <join-column name="userId" referenced-column-name="id" nullable="false"/>
        </many-to-one>
        <unique-constraints>
            <unique-constraint name="UNIQ_LIKES_TREE_USER" columns="treeId,userId"/>
        </unique-constraints>
    </entity>
</doctrine-mapping>