<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Entity\Tree" table="tree" repository-class="App\Repository\TreeRepository">

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="scientificName" column="scientific_name" type="text"/>

        <field name="description" type="text" nullable="true"/>

        <field name="lifespanMin" column="lifespan_min" type="string" length="255"/>

        <field name="lifespanMax" column="lifespan_max" type="string" length="255"/>

        <field name="heightMin" column="height_min" type="string" length="255" nullable="true"/>

        <field name="heightMax" column="height_max" type="string" length="255" nullable="true"/>

        <field name="growthRate" column="growth_rate" type="string" length="255" nullable="true"/>

        <field name="status" type="boolean" nullable="true"/>

        <field name="familyName" column="family_name" type="string" length="255" nullable="true"/>

        <field name="genus" type="string" length="255" nullable="true"/>

        <field name="species" type="string" length="255" nullable="true"/>

        <field name="temperatureRange" column="temperature_range" type="string" length="255" nullable="true"/>

        <field name="rainfallRequirement" column="rainfall_requirement" type="string" length="255" nullable="true"/>

        <field name="waterRequirement" column="water_requirement" type="string" length="255" nullable="true"/>

        <field name="humidity" type="string" length="255" nullable="true"/>

        <field name="altitudeRange" column="altitude_range" type="string" length="255" nullable="true"/>

        <field name="sandySoil" column="sandy_soil" type="boolean" nullable="true"/>

        <field name="claySoil" column="clay_soil" type="boolean" nullable="true"/>

        <field name="loamySoil" column="loamy_soil" type="boolean" nullable="true"/>

        <field name="soilPh" column="soil_ph" type="string" length="255" nullable="true"/>

        <field name="leafType" column="leaf_type" type="string" length="255" nullable="true"/>

        <field name="floweringSeason" column="flowering_season" type="string" length="255" nullable="true"/>

        <field name="harvestTime" column="harvest_time" type="string" length="255" nullable="true"/>

        <field name="productionPerTree" column="production_per_tree" type="string" length="255" nullable="true"/>

        <field name="seedTreatment" column="seed_treatment" type="string" length="255" nullable="true"/>

        <field name="nurseryMethod" column="nursery_method" type="string" length="255" nullable="true"/>

        <field name="plantingDistance" column="planting_distance" type="string" length="255" nullable="true"/>

        <field name="fertilizerSchedule" column="fertilizer_schedule" type="string" length="255" nullable="true"/>

        <field name="irrigationSchedule" column="irrigation_schedule" type="string" length="255" nullable="true"/>

        <field name="pruningGuide" column="pruning_guide" type="string" length="255" nullable="true"/>

        <field name="commonDiseases" column="common_diseases" type="text" nullable="true"/>

        <field name="commonInsects" column="common_insects" type="text" nullable="true"/>

        <field name="symptoms" type="text" nullable="true"/>

        <field name="treatment" type="text" nullable="true"/>

        <one-to-many field="localNames" target-entity="App\Entity\LocalNames" mapped-by="tree" orphan-removal="false">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <one-to-many field="images" target-entity="App\Entity\Images" mapped-by="tree" orphan-removal="false">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <one-to-many field="uses" target-entity="App\Entity\Uses" mapped-by="tree" orphan-removal="false">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <!-- Owning side of Many-to-Many: defines the join table -->
        <many-to-many field="categories" target-entity="App\Entity\Category" inversed-by="trees">
            <cascade>
                <cascade-persist/>
            </cascade>
            <join-table name="tree_categories">
                <join-columns>
                    <join-column name="tree_id" referenced-column-name="id" on-delete="CASCADE"/>
                </join-columns>
                <inverse-join-columns>
                    <join-column name="category_id" referenced-column-name="id" on-delete="CASCADE"/>
                </inverse-join-columns>
            </join-table>
        </many-to-many>

    </entity>
</doctrine-mapping>