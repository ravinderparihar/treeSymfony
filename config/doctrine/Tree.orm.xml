<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Entity\Tree" table="tree" repository-class="App\Repository\TreeRepository">

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="scientificName" column="scientific_name" type="text"/>

        <field name="description" type="text" nullable="true"/>

        <field name="lifespanMin" column="lifespan_min" type="string" length="255"/>

        <field name="lifespanMax" column="lifespan_max" type="string" length="255"/>

        <field name="heightMin" column="height_min" type="string" length="255" nullable="true"/>

        <field name="heightMax" column="height_max" type="string" length="255" nullable="true"/>

        <field name="growthRate" column="growth_rate" type="string" length="255" nullable="true"/>

        <field name="status" type="boolean" nullable="true"/>

        <field name="familyName" column="family_name" type="string" length="255" nullable="true"/>

        <field name="genus" type="string" length="255" nullable="true"/>

        <field name="species" type="string" length="255" nullable="true"/>

        <one-to-many field="localNames" target-entity="App\Entity\LocalNames" mapped-by="tree" orphan-removal="false">
            <cascade>
                <cascade-persist/>
            </cascade>
        </one-to-many>

        <one-to-many field="images" target-entity="App\Entity\Images" mapped-by="tree" orphan-removal="false">
            <cascade>
                <cascade-persist/>
            </cascade>
        </one-to-many>
        
        <one-to-many field="uses" target-entity="App\Entity\Uses" mapped-by="tree" orphan-removal="false">
            <cascade>
                <cascade-persist/>
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>